@page
@{
    ViewData["Title"] = "JV Purchasing Dashboard";
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />
<link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>JV Purchasing Orders</h2>
    </div>
 <div class="d-flex justify-content-between align-items-center mb-4">
        <button class="btn btn-primary" onclick="addNewPo()">
            <i class="bi bi-plus"></i> Add New Purchase Order
        </button>
    </div>
    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-striped table-bordered dt-responsive nowrap" id="potable" style="width:100%">
                <thead class="table-dark">
                    <tr>
                        <th>Order ID</th>
                        <th>PO Number</th>
                        <th>RO Number</th>
                        <th>Company Code</th>
                        <th>Delivery Address</th>
                        <th>Agreed Terms</th>
                        <th>Total Amount</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
    <div class="d-flex justify-content-between align-items-center mt-3">
        <button class="btn btn-primary" onclick="refreshTable()">
            <i class="bi bi-arrow-clockwise"></i> Refresh Data
        </button>
    </div>
</div>

<!-- Modal for Creating a New Purchase Order -->
<div class="modal fade" id="myModal" tabindex="-1" aria-labelledby="modalTitle" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Create PO</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <form id="createPoForm">
                    <div class="row g-3">

                    <div class="col-md-6">
                        <label class="form-label" >PO Number</label>
                        <div class="input-group">
                            <input type="text" id="poNumber" class="form-bg-light form-control" readonly />
                            <button class="btn btn-outline-secondary" type="button" id="btnRefreshPo">
                                <i class="bi bi-arrow-clockwise"></i>
                            </button>
                        </div>
                        <div class="form-check mt-1">
                            <input class="form-check-input" type="checkbox" id="chkManualPo">
                            <label class="form-check-label text-muted small" for="chkManualPo">
                                Override with manual PO number
                            </label>
                        </div>
                    </div>
                      <div class="col-md-6">
                        <label class="form-label" for="roNumber">RO Number</label>
                        <div class="input-group">
                        <input type="text" id="roNumber" class="form-bg-light form-control" />
                        <button class="btn btn-outline-secondary" type="button" id="btnRefreshRo">
                            <i class="bi bi-arrow-clockwise"></i>
                        </button>
                        </div>
                        <div class="form-check mt-1">
                        <label class="form-check-label text-muted small" for="chkManualRo">
                        </label>
                        </div>
                    </div>
                    </div>

                    <div class="row g-3 mt-2">

                    <div class="col-md-6">
                        <label class="form-label"> Company</label>
                        <select class="form-control" id="companyId">
                            <option value="">Select Company</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label"> Supplier</label>
                        <select class="form-control" id="supplierId">
                            <option value="">Select Supplier</option>
                        </select>
                    </div>

                    </div>

                    <div class="row g-3 mt-2">
                    <div class="col-md-6">
                        <label class="form-label"> Terms</label>
                        <select class="form-control" id="termsId">
                            <option value="">Select Applicable Terms</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label"> Delivery Address</label>
                        <select class="form-control" id="deliveryAddress">
                            <option value="">Select Delivery Address</option>
                        </select>
                    </div>
                    <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label"> PO Date</label>
                        <input type="date" class="form-control" id="orderDate" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                    </div>

                        <div class="col-md-6">
                        <label class="form-label"> RO Date</label>
                        <input type="date" class="form-control" id="roDate" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                    </div>
                    </div>

                    <h6> Order Details </h6>
                        <table class="table table-responsive" id="orderTable">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Unit</th>
                                    <th>Quantity</th>
                                    <th>Price</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                            <button type="button" class="btn btn-success" id="btnAddOrder">Add Order</button>
                </form>
                <p>This is your ASP.NET Core modal content container.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" onclick="submitPO()">Submit PO</button>
            </div>
        </div>
    </div>
</div>
<!-- Modal for Viewing Purchase Order Details -->
<div class="modal fade" id="viewModal" tabindex="-1" aria-labelledby="viewModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title" id="viewModalLabel"><i class="bi bi-eye"></i> View Purchase Order</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <table class="table table-bordered">
                    <tr>
                        <th style="width: 40%;">Order ID</th>
                        <td id="viewPoId"></td>
                    </tr>
                    <tr>
                        <th>PO Number</th>
                        <td id="viewPoNumber"></td>
                    </tr>
                    <tr>
                        <th>Delivery Address</th>
                        <td id="viewDeliveryAddress"></td>
                    </tr>
                    <tr>
                        <th>Agreed Terms</th>
                        <td id="viewAgreedTerms"></td>
                    </tr>
                    <tr>
                        <th>Total Amount</th>
                        <td id="viewTotalAmount" class="fw-bold text-success"></td>
                    </tr>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<!-- Modal for Editing a Purchase Order -->
<div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="editForm" onsubmit="submitEdit(event)">
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title" id="editModalLabel"><i class="bi bi-pencil-square"></i> Edit Purchase Order</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="editPoId" />
                    
                    <div class="mb-3">
                        <label for="editPoNumber" class="form-label">PO Number</label>
                        <input type="text" class="form-label form-control" id="editPoNumber" required />
                    </div>
                    
                    <div class="mb-3">
                        <label for="editDeliveryAddress" class="form-label">Delivery Address</label>
                        <textarea class="form-control" id="editDeliveryAddress" rows="2" required></textarea>
                    </div>

                    <div class="mb-3">
                        <label for="editAgreedTerms" class="form-label">Agreed Terms</label>
                        <input type="text" class="form-control" id="editAgreedTerms" required />
                    </div>

                    <div class="mb-3">
                        <label for="editTotalAmount" class="form-label">Total Amount (₱)</label>
                        <input type="number" step="0.01" class="form-control" id="editTotalAmount" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal for Deleting a Purchase Order -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel"><i class="bi bi-trash"></i> Delete Purchase Order</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete Purchase Order <strong id="deletePoNumSpan"></strong>?</p>
                <p class="text-danger"><small>This action cannot be undone.</small></p>
                <input type="hidden" id="deletePoId" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" onclick="submitDelete()">Delete</button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap5.min.js"></script>

    <script>
        let dataTableInstance;
         let autoGeneratedPoNumber = "";

        $(document).ready(function () {

            dataTableInstance = $('#potable').DataTable({
                "order": [[4, "desc"]], 
                "processing": true, 
                "serverSide": true,
                "responsive": true, 
                "ajax": {
                    "url": "/api/po/purchaseorder",
                    "dataSrc": "data", 
                    "error": function (xhr, error, thrown) {
                        console.error("API Error: ", xhr.status, thrown);
                        alert("Failed to load purchase orders. Ensure API is active.");
                    }
                },
                "columns": [
                    { 
                        "data": "poid",
                        "className": "text-center fw-bold"
                    },
                    { 
                        "data": "poNumber", 
                    },
                    {
                        "data": "roNumber",
                        "className": "text-center"
                    },
                    {
                        "data": "companyCode",
                        "className": "text-center"
                    },
                    { 
                        "data": "deliveryAddress",
                        "className": "text-center"
                    },
                    {
                        "data" : "agreedTerms",
                        "className": "text-center"
                    },
                    { 
                        "data": "totalAmount",
                        "className": "text-center fw-bold",
                        "render": function (data, type, row) {
                            if (type === 'display' && data !== null) {
                                return new Intl.NumberFormat('en-US', { 
                                    style: 'currency', 
                                    currency: 'PHP' 
                                }).format(data);
                            }
                            return data;
                        }
                    },
                    {
                        "data": "poid", // Uses the ID to identify which row gets edited/viewed/deleted
                        "orderable": false,
                        "className": "text-center",
                        "render": function (data, type, row) {
                            // Escaping single quotes in text properties to prevent JS syntax breaking
                            const poNumSafe = (row.poNumber || '').replace(/'/g, "\\'");
                            const addressSafe = (row.deliveryAddress || '').replace(/'/g, "\\'");
                            const termsSafe = (row.agreedTerms || '').replace(/'/g, "\\'");
                            const amountSafe = row.totalAmount || 0;

                            return `
                                <div class="btn-group" role="group">
                                    <button class="btn btn-sm btn-info text-white" onclick="viewOrder('${data}', '${poNumSafe}', '${addressSafe}', '${termsSafe}', ${amountSafe})">
                                        <i class="bi bi-eye"></i> View
                                    </button>
                                    <button class="btn btn-sm btn-warning" onclick="editOrder('${data}', '${poNumSafe}', '${addressSafe}', '${termsSafe}', ${amountSafe})">
                                        <i class="bi bi-pencil-square"></i> Edit
                                    </button>
                                    <button class="btn btn-sm btn-danger" onclick="confirmDelete('${data}', '${poNumSafe}')">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </div>
                            `;
                        }
                    }
                ],
                "language": {
                    "emptyTable": "No purchase orders found matching this criteria.",
                    "loadingRecords": "Fetching JV purchasing details..."
                }
            });
        });

        $(document).on('click', '#btnAddOrder', function () {
            addOrderRow();
        });
        function refreshTable() {
            if (dataTableInstance) {
                dataTableInstance.ajax.reload(null, false); 
            }
        }

        // =========================================================
        // MODAL OPERATIONS
        // =========================================================
         
        function addNewPo() {
                generatePoNumber();
                getCompanies();
                getSuppliers();
                getDeliveryAddress();
                getTerms();
                var modal = new bootstrap.Modal(document.getElementById('myModal'));
                $('#chkManualPo').prop('checked', false);
                modal.show();
        }

        function generatePoNumber(){
            const poInput = $('#poNumber');
            poInput.val('Loading....').prop('readonly', true);

            $.get('/api/po/generatePo',function (data){
                if(data && data.poNumber){
                    autoGeneratedPoNumber = data.poNumber;
                    poInput.val(autoGeneratedPoNumber);
                }
            }).fail(function (){
                poInput.val('Error');
            });
        }
        
        $(document.body).ready(function(){
            $('#chkManualPo').on('change', function(){
                const isManual = $(this).is(':checked');
                const poInput = $('#poNumber');

                if(isManual){
                    poInput.prop('readonly', false).val('').focus();
                }
                else{
                    poInput.prop('readonly',true).val(autoGeneratedPoNumber);
                }
            });
        });

        function getSuppliers(){
            $.get('/api/suppliers/vendors', function(data){
                if(data && Array.isArray(data)){
                    const supplierSelect = $('#supplierId');
                    supplierSelect.empty().append('<option value="">Select Supplier</option>');
                    data.forEach(supplier => {
                        supplierSelect.append(`<option value="${supplier.id}">${supplier.supplierName}</option>`);
                    });
                }
            }).fail(function(){
                alert("Failed to load suppliers. Check API connection.");
            });
        }

        function getCompanies(){
            $.get('/api/company/companies', function(data){
                if(data && Array.isArray(data)){
                    const companySelect = $('#companyId');
                    companySelect.empty().append('<option value="">Select Company</option>');
                    data.forEach(company => {
                        companySelect.append(`<option value="${company.id}">${company.name}</option>`);
                    });
                }
            }).fail(function(){
                alert("Failed to load companies. Check API connection.");
            });
        }

        function getDeliveryAddress(){
            $.get('/api/deliveryaddress/deliveryaddress', function(data){
                if(data && Array.isArray(data)){
                    const addressSelect = $('#deliveryAddress');
                    addressSelect.empty().append('<option value="">Select Delivery Address</option>');
                    data.forEach(address => {
                        addressSelect.append(`<option value="${address.id}">${address.address}</option>`);
                    });
                }
            }).fail(function(){
                alert("Failed to load delivery addresses. Check API connection.");
            })
        }

        function getTerms(){
            $.get('/api/terms/terms', function(data){

                if(data && Array.isArray(data)){
                    const termsSelect = $('#termsId');
                    termsSelect.empty().append('<option value="">Select Terms</option>');
                    data.forEach(term => {
                        termsSelect.append(`<option value="${term.id}">${term.term}</option>`);
                    });
                }
            }).fail(function(){
                alert("Failed to load terms. Check API connection.");
            });
        }
        @* function generatePoNumber(){
            if(!localStorage.getItem("lastPoNumber")){
                localStorage.setItem("lastPoNumber", 5456);
            }
            let lastNumber = parseInt(localStorage.getItem("lastPoNumber")) + 1;
            let poNumber = lastNumber.toString().padStart(4, '0');
            $("#poNumber").val(poNumber);
            localStorage.setItem("lastPoNumber", lastNumber);
        } *@

            function submitPO(){
                
                let poNumber = $("#poNumber").val();
                let roNumber = $("#roNumber").val();
                let companyId = $("#companyId").val();
                let supplierId = $("#supplierId").val();
                let deliveryAddress = $("#deliveryAddress").val();
                let termsId = $("#termsId").val();
                let orderDate = $("#orderDate").val();
                let orderDetails = [];
                let totalAmount = 0;

                if(!supplierId || !termsId || !orderDate || !companyId){
                    alert("Please fill in all required fields.");
                    return;
                }

                $("#orderTable tbody tr").each(function(){
                    let product = $(this).find(".product-input").val();
                    let unit = $(this).find(".unitInput").val();
                    let quantity = parseFloat($(this).find(".quantityInput").val()) || 0;
                    let price = parseFloat($(this).find(".priceInput").val()) || 0;

                    if(product && unit && quantity > 0 && price > 0){
                        let lineTotal = quantity * price;
                        totalAmount += lineTotal;

                        //Inside PODetails
                        orderDetails.push({
                            product: product,
                            unit: unit,
                            quantity: quantity,
                            price: price
                        });
                    }
                });

                if(orderDetails.length === 0){
                    alert("Please add at least one valid order detail.");
                    return;
                }

                    let payload = {
                        companyId: parseInt(companyId),
                        companyCode: $("#companyId option:selected").text(),
                        poNumber: poNumber,
                        poDate: orderDate,
                        roNumber: roNumber,                    
                        supplierId: parseInt(supplierId),
                        supplierName: $("#supplierId option:selected").text(),
                        supplierAddress: $("#supplierId option:selected").data("supplierAddress") || "N/A",
                        termsId: parseInt(termsId),
                        deliveryAddress: parseInt(deliveryAddress),
                        // Hardcode valid existing DB IDs for missing UI inputs temporarily
                        //userId: 1,          // Ensure ID 1 exists in your Users table
                        requestedBy: "Dev Test",
                        orderBy: "Dev Test",
                        remarks: "Testing PO submission",
                        
                        poDetails: orderDetails
                    };

                console.log("Submitting payload:", JSON.stringify(payload));

                $.ajax({
                    url: '/api/po/createpo',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(payload),
                    success: function(result){
                        alert("Purchase Order created successfully!");
                        let modalEl = document.getElementById('myModal');
                        let modalInstance = bootstrap.Modal.getInstance(modalEl);
                        modalInstance.hide();
                        refreshTable();
                    },
                    error: function(xhr, status, error){
                        console.error("Error creating PO:", xhr.status, error);
                        alert("Failed to create Purchase Order. Check API connection.");
                    }
                }); 
            }

        // 1. VIEW ACTION

            function addOrderRow() {
                    let supplierId = $("#supplierId").val();
                    
                if(!supplierId){
                        alert("Supplier is Empty.");
                        return;
                }
                // Corrected HTML structure with text input as requested
                let row = `<tr>
                                <td>
                                    <input type="text" class="form-control product-input" placeholder="Enter Product Name" required />
                                </td>
                                <td>
                                    <input type="text" class="form-control unitInput" placeholder="Unit"/>
                                </td>
                                <td>
                                    <input type="number" class="form-control quantityInput" placeholder="Quantity"/>
                                </td>
                                <td>
                                    <input type="number" class="form-control priceInput" placeholder="Price"/>
                                </td>
                                <td>
                                        <span class="totalInput">0.00</span>
                                </td>
                                <td>
                                    <input type="button" class="btn btn-danger btn-sm removeOrderRow" value="X" />
                                </td>
                        </tr>`;

                $("#orderTable").append(row);
            }

            function updateTotal(){
                let total = 0;
                $("#orderTable tbody tr").each(function(){
                    let qty = parseFloat($(this).find(".quantityInput").val()) || 0;
                    let price = parseFloat($(this).find(".priceInput").val()) || 0;
                    let subTotal = qty * price;
                    
                    $(this).find(".totalInput").text(subTotal.toFixed(2));
                    total += subTotal;
                });
                @* $("#totalAmount").text(total.ToFixed(2)); *@
            }
        $(document).on('input', '.quantityInput, .priceInput', function(){
                    updateTotal();
        });
                $(document).on("click", ".removeOrderRow", function(){
            $(this).closest("tr").remove();
            updateTotal();
        });
        function viewOrder(id, poNum, address, terms, amount) {
            $("#viewPoId").text(id);
            $("#viewPoNumber").text(poNum);
            $("#viewDeliveryAddress").text(address);
            $("#viewAgreedTerms").text(terms);
            
            // Format currency inside view modal
            const formattedAmount = new Intl.NumberFormat('en-US', { 
                style: 'currency', 
                currency: 'USD' 
            }).format(amount);
            $("#viewTotalAmount").text(formattedAmount);

            // Show Bootstrap modal
            let viewModal = new bootstrap.Modal(document.getElementById('viewModal'));
            viewModal.show();
        }

        // 2. EDIT ACTION (Open modal with current values populated)
        function editOrder(id, poNum, address, terms, amount) {
            $("#editPoId").val(id);
            $("#editPoNumber").val(poNum);
            $("#editDeliveryAddress").val(address);
            $("#editAgreedTerms").val(terms);
            $("#editTotalAmount").val(amount);

            let editModal = new bootstrap.Modal(document.getElementById('editModal'));
            editModal.show();
        }

        // 3. EDIT FORM SUBMIT (Sends data to the API backend)
        function submitEdit(event) {
            event.preventDefault(); // Stop normal form submit

            const id = $("#editPoId").val();
            const payload = {
                poid: parseInt(id), // Matches typical JSON payload structures
                poNumber: $("#editPoNumber").val(),
                deliveryAddress: $("#editDeliveryAddress").val(),
                agreedTerms: $("#editAgreedTerms").val(),
                totalAmount: parseFloat($("#editTotalAmount").val())
            };

            $.ajax({
                url: `/api/po/purchaseorder/${id}`,
                type: 'PUT',
                contentType: 'application/json',
                data: JSON.stringify(payload),
                success: function (result) {
                    // Hide the modal
                    let editModalEl = document.getElementById('editModal');
                    let modalInstance = bootstrap.Modal.getInstance(editModalEl);
                    modalInstance.hide();

                    // Refresh table & notify
                    refreshTable();
                    alert("Purchase Order updated successfully!");
                },
                error: function (xhr, status, error) {
                    console.error("Update failed:", xhr.status, error);
                    alert("Failed to update the purchase order. Check backend connection.");
                }
            });
        }

        // 4. DELETE CONFIRMATION ACTION
        function confirmDelete(id, poNum) {
            $("#deletePoId").val(id);
            $("#deletePoNumSpan").text(poNum);

            let deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
            deleteModal.show();
        }

        // 5. SUBMIT DELETE TO API
        function submitDelete() {
            const id = $("#deletePoId").val();

            $.ajax({
                url: `/api/po/purchaseorder/${id}`,
                type: 'DELETE',
                success: function (result) {
                    // Hide modal
                    let deleteModalEl = document.getElementById('deleteModal');
                    let modalInstance = bootstrap.Modal.getInstance(deleteModalEl);
                    modalInstance.hide();

                    // Refresh table & notify
                    refreshTable();
                    alert("Purchase Order deleted successfully.");
                },
                error: function (xhr, status, error) {
                    console.error("Delete failed:", xhr.status, error);
                    alert("Failed to delete purchase order.");
                }
            });
        }
    </script>
}