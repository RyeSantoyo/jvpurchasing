@page
@{
    ViewData["Title"] = "JV Purchasing Dashboard";
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />
<link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
<script src="~/js/global.js"></script>
<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>JV Purchasing Orders</h2>
    </div>
 <div class="d-flex justify-content-between align-items-center mb-4">
        <button class="btn btn-primary" onclick="addNewPo()">
            <i class="bi bi-plus"></i> Add New Purchase Order
        </button>
    </div>
    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-striped table-bordered dt-responsive nowrap" id="potable" style="width:100%">
                <thead class="table-dark">
                    <tr>
                        <th>Order ID</th>
                        <th>PO Number</th>
                        <th>RO Number</th>
                        <th>Company Code</th>
                        <th>Delivery Address</th>
                        <th>Agreed Terms</th>
                        <th>Total Amount</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                </tbody>
            </table>
        </div>
    </div>
    <div class="d-flex justify-content-between align-items-center mt-3">
        <button class="btn btn-primary" onclick="refreshTable()">
            <i class="bi bi-arrow-clockwise"></i> Refresh Data
        </button>
    </div>
</div>

<!-- Modal for Creating a New Purchase Order -->
<div class="modal fade" id="myModal" tabindex="-1" aria-labelledby="modalTitle" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Create PO</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <form id="createPoForm">
                    <div class="row g-3">

                        <div class="col-md-6">
                            <label class="form-label" >PO Number</label>
                            <div class="input-group">
                                <input type="text" id="poNumber" class="form-bg-light form-control" readonly />
                                <button class="btn btn-outline-secondary" type="button" id="btnRefreshPo">
                                    <i class="bi bi-arrow-clockwise"></i>
                                </button>
                            </div>
                            <div class="form-check mt-1">
                                <input class="form-check-input" type="checkbox" id="chkManualPo">
                                <label class="form-check-label text-muted small" for="chkManualPo">
                                    Override with manual PO number
                                </label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="roNumber">RO Number</label>
                            <div class="input-group">
                            <input type="text" id="roNumber" class="form-bg-light form-control" />
                            <button class="btn btn-outline-secondary" type="button" id="btnRefreshRo">
                                <i class="bi bi-arrow-clockwise"></i>
                            </button>
                            </div>
                            <div class="form-check mt-1">
                            <label class="form-check-label text-muted small" for="chkManualRo">
                            </label>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mt-2">

                    <div class="col-md-6">
                        <label class="form-label"> Company</label>
                        <select class="form-control" id="companyId">
                            <option value="">Select Company</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label"> Supplier</label>
                        <select class="form-control" id="supplierId">
                            <option value="">Select Supplier</option>
                        </select>
                    </div>

                    </div>

                    <div class="row g-3 mt-2">
                        <div class="col-md-6">
                            <label class="form-label"> Terms</label>
                            <select class="form-control" id="termsId">
                                <option value="">Select Applicable Terms</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label"> Delivery Address</label>
                            <select class="form-control" id="deliveryAddressId">
                                <option value="">Select Delivery Address</option>
                            </select>
                        </div>
                    </div>

                     <div class="row g-3 mt-2">
                        <div class="col-md-6">
                            <label class="form-label">Order by: </label>
                            <input type="text" class="form-control" id="orderBy" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label"> Requested by: </label>
                            <input type="text" class="form-control" id="requestedBy" />
                        </div>
                    </div>                   
                    <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label"> PO Date</label>
                        <input type="date" class="form-control" id="orderDate" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                    </div>

                        <div class="col-md-6">
                        <label class="form-label"> RO Date</label>
                        <input type="date" class="form-control" id="roDate" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                    </div>
                    </div>

                    <h6> Order Details </h6>
                        <table class="table table-responsive" id="orderTable">
                            <thead>
                                <tr>
                                    <th>Product</th>
                                    <th>Unit</th>
                                    <th>Quantity</th>
                                    <th>Price</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                            <button type="button" class="btn btn-success" id="btnAddOrder">Add Order</button>
                </form>
                <p>This is your ASP.NET Core modal content container.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" onclick="submitPO()">Submit PO</button>
            </div>
        </div>
    </div>
</div>
<!-- Modal for Viewing Purchase Order Details -->
<div class="modal fade" id="viewModal" tabindex="-1" aria-labelledby="viewModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title" id="viewModalLabel"><i class="bi bi-eye"></i> View Purchase Order</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <table class="table table-bordered">
                    <tr>
                        <th style="width: 40%;">Order ID</th>
                        <td id="viewPoId"></td>
                    </tr>
                    <tr>
                        <th>PO Number</th>
                        <td id="viewPoNumber"></td>
                    </tr>
                    <tr>
                        <th>RO Number</th>
                        <td id="viewRoNumber"></td>
                    </tr>
                    <tr>
                        <th>Delivery Address</th>
                        <td id="viewDeliveryAddress"></td>
                    </tr>
                    <tr>
                        <th>Agreed Terms</th>
                        <td id="viewAgreedTerms"></td>
                    </tr>
                    <tr>
                        <th>Total Amount</th>
                        <td id="viewTotalAmount" class="fw-bold text-success"></td>
                    </tr>
                </table>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" onClick="printOrder()">Print</button>
            </div>
        </div>
    </div>
</div>
<!-- Modal for Editing a Purchase Order -->
<div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="editForm" onsubmit="submitEdit(event)">
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title" id="editModalLabel"><i class="bi bi-pencil-square"></i> Edit Purchase Order</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">

                        <div class="row g-3">
                        <input type="hidden" id="editPoId" />
                        
                        <div class="col-md-6">
                            <label for="editPoNumber" class="form-label">PO Number</label>
                            <input type="text" class="form-label form-control" id="editPoNumber" readonly />
                        </div>

                        <div class="col-md-6">
                            <label for="editRoNumber" class="form-label">RO Number</label>
                            <input type="text" class="form-label form-control" id="editRoNumber" readonly />
                        </div>                    
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Company</label>
                            <select class="form-control" id="editCompanyId">
                                <option value="">Select Company</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Supplier</label>
                            <select class="form-control" id="editSupplierId">
                                <option value="">Select Supplier</option>
                            </select>
                        </div>
                    </div>
                    <div class="row g-3 mt-2">
                        <div class="col-md-6">
                            <label class="form-label"> Terms</label>
                            <select class="form-control" id="editAgreedTermsId">
                                <option value="">Select Applicable Terms</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label"> Delivery Address</label>
                            <select class="form-control" id="editDeliveryAddressId">
                                <option value="">Select Delivery Address</option>
                            </select>
                        </div>
                    </div>                    
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label"> PO Date</label>
                            <input type="date" class="form-control" id="orderDate" value="@DateTime.Now.ToString("yyyy-MM-dd")" readonly />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label"> RO Date</label>
                            <input type="date" class="form-control" id="roDate" value="@DateTime.Now.ToString("yyyy-MM-dd")" readonly />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="editTotalAmount" class="form-label">Total Amount (₱)</label>
                        <input type="number" step="0.01" class="form-control" id="editTotalAmount" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-warning">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal for Deleting a Purchase Order -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel"><i class="bi bi-trash"></i> Delete Purchase Order</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete Purchase Order <strong id="deletePoNumSpan"></strong>?</p>
                <p class="text-danger"><small>This action cannot be undone.</small></p>
                <input type="hidden" id="deletePoId" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" onclick="submitDelete()">Delete</button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap5.min.js"></script>
    <script src="~/js/purchaseorder.js"></script>
}