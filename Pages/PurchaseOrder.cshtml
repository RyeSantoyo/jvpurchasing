@page
@{
    ViewData["Title"] = "JV Purchasing Dashboard";
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />
<link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css" />

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>JV Purchasing Orders</h2>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-striped table-bordered dt-responsive nowrap" id="potable" style="width:100%">
                <thead class="table-dark">
                    <tr>
                        <th>Order ID</th>
                        <th>PO Number</th>
                        <th>Delivery Address</th>
                        <th>Agreed Terms</th>
                        <th>Total Amount</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    </tbody>
            </table>
        </div>
    </div>
        <div class="d-flex justify-content-between align-items-center mb-4">
        <button class="btn btn-primary" onclick="refreshTable()">
            <i class="bi bi-arrow-clockwise"></i> Refresh Data
        </button>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/responsive.bootstrap5.min.js"></script>

    <script>
        let dataTableInstance;

        $(document).ready(function () {
            // Initialize DataTables with advanced configurations
            dataTableInstance = $('#potable').DataTable({
                "order": [[0, "desc"]], // Default sorting on the first column (Order ID) in descending order
                "processing": true, // Displays a loading indicator while fetching data
                "responsive": true, // Automatically hides columns gracefully on smaller screens
                "ajax": {
                    //"url": "/api/po/po-details", // Backend API endpoint for fetching purchase orders
                    "url": "/api/po/purchaseorder",
                    "dataSrc": "", // Tells DataTables that the API returns a flat JSON array
                    "error": function (xhr, error, thrown) {
                        console.error("API Error: ", xhr.status, thrown);
                        alert("Failed to load purchase orders from the backend API. Please ensure your endpoint is running.");
                    }
                },
                "columns": [
                    { 
                        "data": "poid",
                        "className": "text-center fw-bold"
                    },
                    { 
                        "data": "poNumber", 
                    },
                    { 
                        "data": "deliveryAddress",
                        "className": "text-center"
                    },
                    {
                        "data" : "agreedTerms",
                        "className": "text-center"
                    },
                    { 
                        "data": "totalAmount",
                        "className": "text-center fw-bold",
                        "render": function (data, type, row) {
                            // Automatically formats numbers into a currency format ($#,##0.00)
                            if (type === 'display' && data !== null) {
                                return new Intl.NumberFormat('en-US', { 
                                    style: 'currency', 
                                    currency: 'USD' 
                                }).format(data);
                            }
                            return data;
                        }
                    }

                ],
                "language": {
                    "emptyTable": "No purchase orders found matching this criteria.",
                    "loadingRecords": "Fetching JV purchasing details..."
                }
            });
        });

        // Helper function tied to the refresh button
        function refreshTable() {
            if (dataTableInstance) {
                dataTableInstance.ajax.reload(null, false); // Reloads data without resetting user pagination
            }
        }
    </script>
}